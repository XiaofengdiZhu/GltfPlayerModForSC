    },
    "crouch_tired": {
      "source": "Kneeling Tired",
      "loop": true,
      "blendDuration": 0.3
    },
    "crouch_idle": {
      "source": "Crouch_Idle_Loop",
      "loop": true,
      "blendDuration": 0.3
    },
    "run": {
      "source": "Sprint_Loop",
      "loop": true,
      "blendDuration": 0.25
    },
    "walk": {
      "source": "Walk_Loop",
      "loop": true,
      "blendDuration": 0.25
    },
    "shivering": {
      "source": "Shivering",
      "loop": true,
      "blendDuration": 0.3
    },
    "idle_tired": {
      "source": "Zombie_Idle_Loop",
      "loop": true,
      "blendDuration": 0.3
    },
    "idle": {
      "source": "Idle_Loop",
      "loop": true,
      "blendDuration": 0.3
    },
    "pickup": {
      "source": "PickUp_Table",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.2,
      "onComplete": { "type": "trigger", "name": "PickUpComplete" },
      "onInterrupt": { "type": "trigger", "name": "PickUpInterrupt" }
    },
    "attacked": {
      "source": "Pistol_Aim_Up",
      "loop": false,
      "startPhase": 0,
      "endPhase": 0,
      "preservePose": true,
      "blendDuration": 0.25,
      "onComplete": { "type": "trigger", "name": "AttackedComplete" }
    },
    "melee_idle": {
      "source": "Sword_Idle",
      "loop": true,
      "blendDuration": 0.3
    },
    "punch_right": {
      "source": "Punch_Cross",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.1,
      "events": [
        { "time": 0.3, "name": "MeleeImpact", "data": "pending|complete" }
      ],
      "onComplete": { "type": "trigger", "name": "MeleeAttackComplete" }
    },
    "punch_left": {
      "source": "Punch_Jab",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.1,
      "events": [
        { "time": 0.3, "name": "MeleeImpact", "data": "pending|complete" }
      ],
      "onComplete": { "type": "trigger", "name": "MeleeAttackComplete" }
    },
    "ride_boat": {
      "source": "Meditate",
      "loop": true,
      "blendDuration": 0.5,
      "rootBoneTranslation": [0, 0.15, 0]
    },
    "ride": {
      "source": "Power Up",
      "loop": true,
      "blendDuration": 0.5,
      "rootBoneTranslation": [0, 0.15, 0]
    },
    "dig_harvest": {
      "source": "Farm_Harvest",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.1,
      "onComplete": { "type": "trigger", "name": "DigLoopComplete" },
      "onInterrupt": { "type": "trigger", "name": "DigInterrupt" }
    },
    "dig_general": {
      "source": "TreeChopping_Loop",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.1,
      "onComplete": { "type": "trigger", "name": "DigLoopComplete" },
      "onInterrupt": { "type": "trigger", "name": "DigInterrupt" }
    },
    "place_seed": {
      "source": "Farm_Watering",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.1,
      "onComplete": { "type": "trigger", "name": "PlaceLoopComplete" },
      "onInterrupt": { "type": "trigger", "name": "PlaceLoopComplete" }
    },
    "place_general": {
      "source": "TreeChopping_Loop",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.1,
      "onComplete": { "type": "trigger", "name": "PlaceLoopComplete" },
      "onInterrupt": { "type": "trigger", "name": "PlaceLoopComplete" }
    },
    "use_general": {
      "source": "TreeChopping_Loop",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.1,
      "onComplete": { "type": "trigger", "name": "UseLoopComplete" },
      "onInterrupt": { "type": "trigger", "name": "UseLoopComplete" }
    },
    "interact_chest": {
      "source": "Chest_Open",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.1,
      "events": [
        { "time": 0.5, "name": "InteractImpact", "data": "pending" }
      ],
      "onComplete": { "type": "trigger", "name": "InteractComplete" },
      "onInterrupt": { "type": "trigger", "name": "InteractComplete" }
    },
    "interact_general": {
      "source": "Interact",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.1,
      "speed": 2.0,
      "events": [
        { "time": 0.4, "name": "InteractImpact", "data": "pending" }
      ],
      "onComplete": { "type": "trigger", "name": "InteractComplete" },
      "onInterrupt": { "type": "trigger", "name": "InteractComplete" }
    },
    "aim_musket": {
      "source": "Pistol_Idle_Loop",
      "loop": true,
      "blendDuration": 0.15
    },
    "shoot_musket": {
      "source": "Pistol_Shoot",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.05,
      "onComplete": { "type": "trigger", "name": "ShootComplete" }
    },
    "throw_general": {
      "source": "OverhandThrow",
      "loop": false,
      "preservePose": true,
      "blendDuration": 0.05,
      "events": [
        { "time": 0.25, "name": "AimImpact", "data": "pending" }
      ],
      "onComplete": { "type": "trigger", "name": "ThrowComplete" },
      "onInterrupt": { "type": "trigger", "name": "AimImpact" }
    }
  },
  "states": {
    "base": {
      "layer": "Base",
      "rules": [
        {
          "condition": "[IsDead]",
          "animation": "death"
        },
        {
          "condition": "[JumpPhase] == 'ClimbUp'",
          "animation": "climbup"
        },
        {
          "condition": "[JumpPhase] == 'Land'",
          "animation": "jump_land"
        },
        {
          "condition": "[IsRiding]",
          "animation": "idle"
        },
        {
          "condition": "[IsWakingUp]",
          "animation": "wakeup"
        },
        {
          "condition": "[LieDownFactor] > 0",
          "animation": "sleep"
        },
        {
          "condition": "[IsInWater]",
          "rules": [
            {
              "condition": "[SpeedAbs] > 0.4",
              "animation": {
                "source": "swim",
                "speed": "[MoveSpeed]"
              }
            },
            {
              "condition": "true",
              "animation": "swim_idle"
            }
          ]
        },
        {
          "condition": "![IsOnGround]",
          "rules":[
            {
              "condition": "[IsFlying]",
              "rules": [
                {
                  "condition": "[SpeedAbs] > 0.2",
                  "animation": "fly"
                },
                {
                  "condition": "true",
                  "animation": "fly_idle"
                }
              ]
            },
            {
              "condition": "[IsOnLadder] > 0.0",
              "animation": {
                "source": "crawl",
                "speed": "[VelocityY] * 1.2"
              }
            },
            {
              "condition": "[JumpPhase] == 'Start'",
              "animation": "jump_start"
            },
            {
              "condition": "true",
              "animation": "jump_loop"
            }
          ]
        },
        {
          "condition": "[CrouchFactor] > 0.0",
          "rules": [
            {
              "condition": "[SpeedAbs] > 0.2",
              "animation": {
                "source": "crouch_walk",
                "speed": "[MoveSpeed] * 1.1"
              }
            },
            {
              "condition": "[IsTired]",
              "animation": "crouch_tired"
            },
            {
              "condition": "true",
              "animation": "crouch_idle"
            }
          ]
        },
        {
          "condition": "[SpeedAbs] > [WalkSpeed] * 0.8",
          "animation": {
            "source": "run",
            "speed": "[MoveSpeed] * 0.225"
          }
        },
        {
          "condition": "[SpeedAbs] > 0.2",
          "animation": {
            "source": "walk",
            "speed": "[MoveSpeed] * 0.8"
          }
        },
        { "condition": "[IsThrowing]", "animation": "throw_general" },
        { "condition": "[IsDigging] && [IsDiggingPlant]", "animation": "dig_harvest" },
        {
          "condition": "[IsPickingUp]",
          "animation": "pickup"
        },
        {
          "condition": "[IsHoldingMeleeWeapon]",
          "animation": "melee_idle"
        },
        {
          "condition": "[IsShivering]",
          "animation": "shivering"
        },
        {
          "condition": "[IsTired]",
          "animation": "idle_tired"
        },
        {
          "condition": "[RandomIdleEvent] != ''",
          "animation": {
            "source": "[RandomIdleEvent]",
            "loop": false,
            "preservePose": true,
            "blendDuration": 0.3,
            "onComplete": { "type": "trigger", "name": "RandomIdleComplete" }
          }
        },
        {
          "condition": "true",
          "animation": "idle"
        }
      ]
    },
    "activity": {
      "layer": "Activity",
      "rules": [
        { "condition": "[IsFiring]", "animation": "shoot_musket" },
        { "condition": "[IsInteracting] && [IsInteractChest]", "animation": "interact_chest" },
        { "condition": "[IsInteracting]", "animation": "interact_general" },
        { "condition": "[IsPlacing] && [IsPlacingPlant]", "animation": "place_seed" },
        { "condition": "[IsPlacing]", "animation": "place_general" },
        { "condition": "[IsUsing]", "animation": "use_general" },
        { "condition": "[IsDigging] && [IsDiggingPlant]", "animation": null },
        { "condition": "[IsDigging]", "animation": "dig_general" },
        { "condition": "[IsAiming]", "animation": "aim_musket" },
        { "condition": "[IsThrowingUpperBody]", "animation": "throw_general" },
        {
          "condition": "[IsAttacking] && [AttackComboParity] == 0",
          "animation": "punch_right"
        },
        {
          "condition": "[IsAttacking] && [AttackComboParity] == 1",
          "animation": "punch_left"
        },
        {
          "condition": "true",
          "animation": null
        }
      ]
    },
    "ride": {
      "layer": "Ride",
      "rules": [
        {
          "condition": "[IsBoat]",
          "animation": "ride_boat"
        },
        {
          "condition": "[IsRiding]",
          "animation": "ride"
        },
        {
          "condition": "true",
          "animation": null
        }
      ]
    },
    "attacked": {
      "layer": "UpperBody",
      "rules": [
        {
          "condition": "[IsAttacked]",
          "animation": "attacked"
        },
        {
          "condition": "true",
          "animation": null
        }
      ]
    },
    "bodyturn": {
      "layer": "BodyTurn",
      "rules": [
        {
          "condition": "[IsDead] == false && [LieDownFactor] == 0 && [JumpPhase] != 'ClimbUp'",
          "animation": {
            "source": "driver:GltfBodyTurn"
          }
        },
        {
          "condition": "true",
          "animation": null
        }
      ]
    }
  },
  "boneAliases": {
    "Body": "spine_03",
    "Head": "head",
    "Hand1": "hand_l",
    "Hand2": "hand_r",
    "Leg1": "thigh_l",
    "Leg2": "thigh_r"
  },
  "parameters": {
    "IsDead": false,
    "IsRiding": false,
    "IsInWater": false,
    "IsOnGround": true,
    "IsFlying": false,
    "IsOnLadder": false,
    "VelocityY": 0.0,
    "CrouchFactor": 0.0,
    "Speed": 0.0,
    "SpeedAbs": 0.0,
    "WalkSpeed": 3.1,
    "PokingPhase": 0.0,
    "IsBoat": false,
    "IsHoldingMeleeWeapon": false,
    "IsPickingUp": false,
    "IsAttacked": false,
    "IsAttacking": false,
    "AttackComboParity": 0.0,
    "MoveSpeed": 0.0,
    "WalkOrderX": 0.0,
    "WalkOrderY": 0.0,
    "IsDigging": false,
    "IsDiggingPlant": false,
    "IsPlacing": false,
    "IsPlacingPlant": false,
    "IsUsing": false,
    "IsInteracting": false,
    "IsInteractChest": false,
    "IsAiming": false,
    "IsFiring": false,
    "IsThrowing": false,
    "IsThrowingUpperBody": false,
    "RandomIdleEvent": ""
  }
}
